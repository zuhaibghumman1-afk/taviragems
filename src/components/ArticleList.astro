---
import Base from '../layouts/Base.astro';
import { articleKinds, getColor } from '../data/taxonomy';
import { getArticles, articleUrl, readingMinutes, gemSvg } from '../lib/stones';

interface Props { kind: 'learn' | 'compare' | 'journal' }
const kind = articleKinds.find((k) => k.slug === Astro.props.kind)!;
const articles = await getArticles(kind.slug);
---
<Base title={kind.title} description={kind.intro}>
  <section class="dark">
    <div class="wrap page-head">
      <ol class="crumbs"><li><a href="/">Home</a></li><li aria-current="page">{kind.title}</li></ol>
      <h1>{kind.title}</h1>
      <p class="intro">{kind.intro}</p>
    </div>
  </section>
  <section class="band">
    <div class="wrap">
      {articles.length ? (
        <div class="articles">
          {articles.map((a) => (
            <a class="article-card" href={articleUrl(a)}>
              <div class="article-card__media">{a.data.image ? <img class="photo" src={a.data.image} alt={a.data.image_alt ?? ''} loading="lazy" /> : <Fragment set:html={gemSvg(getColor('white')!.shades)} />}</div>
              <h3>{a.data.title}</h3>
              {a.data.summary && <p>{a.data.summary}</p>}
              <span class="article-card__read">{readingMinutes(a.body ?? '')} min read</span>
            </a>
          ))}
        </div>
      ) : <p class="empty">New {kind.title.toLowerCase()} are being written and will appear here soon.</p>}
    </div>
  </section>
</Base>
