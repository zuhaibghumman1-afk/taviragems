---
import '@fontsource/jost/latin-300.css';
import '@fontsource/jost/latin-400.css';
import '@fontsource/jost/latin-500.css';
import '@fontsource/cormorant-garamond/latin-400.css';
import '@fontsource/cormorant-garamond/latin-500.css';
import '@fontsource/cormorant-garamond/latin-400-italic.css';
import '../styles/global.css';
import site from '../data/site.json';
import { sections, articleKinds } from '../data/taxonomy';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  schema?: Record<string, unknown> | Record<string, unknown>[];
}
const { title, description = site.description, image, type = 'website', schema } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : `${site.name}: ${site.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(image, Astro.site).href : undefined;
const path = Astro.url.pathname;
const isActive = (prefix: string) => path.startsWith(prefix);
const year = new Date().getFullYear();
const schemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
---
<!doctype html>
<html lang="en-US">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{fullTitle}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="sitemap" href="/sitemap-index.xml">
  <meta name="theme-color" content="#111013">
  <meta property="og:site_name" content={site.name}>
  <meta property="og:title" content={title ?? site.name}>
  <meta property="og:description" content={description}>
  <meta property="og:type" content={type}>
  <meta property="og:url" content={canonical}>
  {ogImage && <meta property="og:image" content={ogImage}>}
  <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'}>
  {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  {site.analytics_token && (
    <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: site.analytics_token })}></script>
  )}
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-header">
    <div class="wrap nav">
      <a class="logo" href="/" aria-label="Tavira Gems home">TAVIRA <span>GEMS</span></a>
      <nav aria-label="Main">
        <ul class="menu">
          {sections.map((s) => (
            <li class="has">
              <a href={`/${s.slug}/`} aria-current={isActive(`/${s.slug}/`) ? 'page' : undefined}>{s.slug === 'decorative-stones' ? 'Decorative Stones' : s.name}</a>
              <ul class="dropdown">
                {s.categories.map((c) => <li><a href={`/${s.slug}/${c.slug}/`}>{c.name}</a></li>)}
                <li><a href={`/${s.slug}/`}>All {s.name}</a></li>
              </ul>
            </li>
          ))}
          <li class="has">
            <a href="/learn/" aria-current={isActive('/learn/') ? 'page' : undefined}>Learn</a>
            <ul class="dropdown">
              <li><a href="/learn/">Guides</a></li>
              <li><a href="/birthstones/">Birthstones</a></li>
              <li><a href="/stones/">A–Z Index</a></li>
            </ul>
          </li>
          <li><a href="/compare/" aria-current={isActive('/compare/') ? 'page' : undefined}>Compare</a></li>
          <li><a href="/journal/" aria-current={isActive('/journal/') ? 'page' : undefined}>Journal</a></li>
        </ul>
      </nav>
      <div class="tools">
        <a class="icon-btn" href="/search/" aria-label="Search">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        </a>
        <button class="icon-btn burger" type="button" aria-expanded="false" aria-controls="mobile-nav" aria-label="Open menu" id="burger">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M3 7h18M3 12h18M3 17h18"/></svg>
        </button>
      </div>
    </div>
    <nav class="mobile-nav" id="mobile-nav" aria-label="Mobile" hidden>
      <div class="wrap">
        {sections.map((s) => (
          <details>
            <summary>{s.name}</summary>
            <div>
              {s.categories.map((c) => <a href={`/${s.slug}/${c.slug}/`}>{c.name}</a>)}
              <a href={`/${s.slug}/`}>All {s.name}</a>
            </div>
          </details>
        ))}
        <a href="/learn/">Learn</a>
        <a href="/compare/">Compare</a>
        <a href="/journal/">Journal</a>
        <a href="/birthstones/">Birthstones</a>
        <a href="/stones/">A–Z Index</a>
      </div>
    </nav>
  </header>

  <main id="main">
    <slot />
  </main>

  <footer class="site-footer">
    <div class="wrap">
      <div class="fgrid">
        <div class="about">
          <a class="logo" href="/">TAVIRA <span>GEMS</span></a>
          <p>An encyclopedia of gemstones, decorative stones and rare minerals.</p>
        </div>
        <div>
          <h2>Explore</h2>
          <ul>
            {sections.map((s) => <li><a href={`/${s.slug}/`}>{s.name}</a></li>)}
            <li><a href="/stones/">A–Z Index</a></li>
          </ul>
        </div>
        <div>
          <h2>Learn</h2>
          <ul>
            {articleKinds.map((k) => <li><a href={`/${k.slug}/`}>{k.title}</a></li>)}
            <li><a href="/birthstones/">Birthstones</a></li>
          </ul>
        </div>
        <div>
          <h2>Tavira Gems</h2>
          <ul>
            <li><a href="/about/">About</a></li>
            <li><a href="/editorial-standards/">Editorial Standards</a></li>
            <li><a href="/contact/">Contact</a></li>
          </ul>
        </div>
        <div>
          <h2>Legal</h2>
          <ul>
            <li><a href="/privacy-policy/">Privacy Policy</a></li>
            <li><a href="/terms/">Terms of Use</a></li>
            <li><a href="/disclaimer/">Disclaimer</a></li>
            <li><a href="/image-credits/">Image Credits</a></li>
          </ul>
        </div>
      </div>
      <div class="legal"><span>© {year} Tavira Gems. All rights reserved.</span><span>taviragems.com</span></div>
    </div>
  </footer>

  <script>
    const b = document.getElementById('burger');
    const m = document.getElementById('mobile-nav');
    b?.addEventListener('click', () => {
      const open = b.getAttribute('aria-expanded') === 'true';
      b.setAttribute('aria-expanded', String(!open));
      b.setAttribute('aria-label', open ? 'Open menu' : 'Close menu');
      if (m) m.hidden = open;
    });
  </script>
</body>
</html>
